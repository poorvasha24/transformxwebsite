  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-display: \'Orbitron\', -apple-system, BlinkMacSystemFont, sans-serif;\n    --font-heading: \'Chakra Petch\', \'Rajdhani\', sans-serif;\n    --font-mono: \'Share Tech Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-heading);\n    background-color: #060913;\n    color: #e2e8f0;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, .font-orbitron {\n    font-family: var(--font-display);\n  }\n\n  .font-mono-tech {\n    font-family: var(--font-mono);\n  }\n}\n\n/* Mechanical Angular Clip Paths */\n.clip-chamfer {\n  clip-path: polygon(\n    14px 0%,\n    calc(100% - 14px) 0%,\n    100% 14px,\n    100% calc(100% - 14px),\n    calc(100% - 14px) 100%,\n    14px 100%,\n    0% calc(100% - 14px),\n    0% 14px\n  );\n}\n\n.clip-chamfer-lg {\n  clip-path: polygon(\n    24px 0%,\n    calc(100% - 24px) 0%,\n    100% 24px,\n    100% calc(100% - 24px),\n    calc(100% - 24px) 100%,\n    24px 100%,\n    0% calc(100% - 24px),\n    0% 24px\n  );\n}\n\n.clip-corner-tl-br {\n  clip-path: polygon(\n    20px 0%,\n    100% 0%,\n    100% calc(100% - 20px),\n    calc(100% - 20px) 100%,\n    0% 100%,\n    0% 20px\n  );\n}\n\n.clip-corner-tr-bl {\n  clip-path: polygon(\n    0% 0%,\n    calc(100% - 20px) 0%,\n    100% 20px,\n    100% 100%,\n    20px 100%,\n    0% calc(100% - 20px)\n  );\n}\n\n.clip-banner {\n  clip-path: polygon(\n    16px 0%,\n    100% 0%,\n    calc(100% - 16px) 100%,\n    0% 100%\n  );\n}\n\n.clip-bracket-l {\n  clip-path: polygon(0 0, 100% 0, 100% 4px, 4px 4px, 4px calc(100% - 4px), 100% calc(100% - 4px), 100% 100%, 0 100%);\n}\n\n.clip-bracket-r {\n  clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 4px, 0 4px);\n}\n\n/* Cybernetic Scanlines & Circuit Grids */\n.bg-cyber-grid {\n  background-size: 36px 36px;\n  background-image: \n    linear-gradient(to right, rgba(0, 240, 255, 0.05) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px);\n}\n\n.bg-cyber-dots {\n  background-size: 24px 24px;\n  background-image: radial-gradient(rgba(0, 240, 255, 0.15) 1px, transparent 1px);\n}\n\n.bg-hazard-stripes {\n  background: repeating-linear-gradient(\n    -45deg,\n    rgba(239, 68, 68, 0.18),\n    rgba(239, 68, 68, 0.18) 10px,\n    rgba(15, 23, 42, 0.6) 10px,\n    rgba(15, 23, 42, 0.6) 20px\n  );\n}\n\n.bg-hazard-stripes-cyan {\n  background: repeating-linear-gradient(\n    -45deg,\n    rgba(6, 182, 212, 0.15),\n    rgba(6, 182, 212, 0.15) 8px,\n    rgba(15, 23, 42, 0.6) 8px,\n    rgba(15, 23, 42, 0.6) 16px\n  );\n}\n\n/* Glowing Neon Utilities */\n.glow-cyan {\n  filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.6)) drop-shadow(0 0 20px rgba(0, 240, 255, 0.3));\n}\n\n.glow-red {\n  filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.7)) drop-shadow(0 0 20px rgba(239, 68, 68, 0.35));\n}\n\n.glow-blue {\n  filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.7)) drop-shadow(0 0 20px rgba(59, 130, 246, 0.35));\n}\n\n.text-glow-cyan {\n  text-shadow: 0 0 10px rgba(6, 182, 212, 0.8), 0 0 20px rgba(6, 182, 212, 0.4);\n}\n\n.text-glow-red {\n  text-shadow: 0 0 10px rgba(239, 68, 68, 0.8), 0 0 20px rgba(239, 68, 68, 0.4);\n}\n\n.text-glow-white {\n  text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 0 24px rgba(56, 189, 248, 0.6);\n}\n\n/* Scanline Animation */\n@keyframes scanline {\n  0% {\n    transform: translateY(-100%);\n  }\n  100% {\n    transform: translateY(1000%);\n  }\n}\n\n.animate-scanline {\n  animation: scanline 8s linear infinite;\n}\n\n/* Mechanical Pulse */\n@keyframes mech-pulse {\n  0%, 100% {\n    opacity: 0.3;\n    transform: scale(0.98);\n  }\n  50% {\n    opacity: 0.9;\n    transform: scale(1.02);\n  }\n}\n\n.animate-mech-pulse {\n  animation: mech-pulse 3s ease-in-out infinite;\n}\n\n/* Custom Scrollbar for Sci-Fi HUD */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #070b14;\n  border-left: 1px solid rgba(0, 240, 255, 0.1);\n}\n\n::-webkit-scrollbar-thumb {\n  background: #1e293b;\n  border: 1px solid #00f0ff;\n  border-radius: 2px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #ef4444;\n  border-color: #ff4d4d;\n}\n"
    }
