      target_content: "        {/* Tactical Mission Briefing Chassis */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.92, y: 20 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.92, y: 20 }}\n          transition={{ duration: 0.35, ease: [0.16, 1, 0.3, 1] }}\n          className=\"relative w-full max-w-4xl bg-gradient-to-b from-[#0a1222] via-[#070d18] to-[#03060c] border-2 border-cyan-400 p-6 sm:p-8 clip-chamfer-lg shadow-[0_0_50px_rgba(0,240,255,0.4)] my-auto max-h-[90vh] overflow-y-auto pointer-events-auto\"\n        >\n          {/* Top Armor Flange & Close Button */}\n          <div className=\"flex items-center justify-between pb-4 mb-6 border-b border-cyan-500/40\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"font-mono text-xs font-bold px-2.5 py-1 bg-cyan-950 text-cyan-300 border border-cyan-500/50 clip-banner\">\n                DOM_KEY: {theme.armorCode}\n              </span>\n              <div className=\"flex items-center gap-1.5 text-xs font-mono text-slate-400\">\n                <Target className=\"w-4 h-4 text-red-500 animate-pulse\" />\n                <span>TARGET DOMAIN // SECTOR_{theme.number}</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => {\n                playClick();\n                onClose();\n              }}\n              className=\"p-1.5 bg-slate-900 border border-red-500/60 hover:bg-red-950 text-red-400 hover:text-white clip-chamfer transition-colors cursor-pointer flex items-center gap-1 text-xs font-mono\"\n            >\n              <span>CLOSE BRIEFING</span>\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Main Briefing Header */}\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6\">\n            <div>\n              <div className=\"font-mono text-xs text-red-400 tracking-widest font-semibold mb-1\">\n                NATIONAL INNOVATION THEME #{theme.number}\n              </div>\n              <h3 className=\"text-2xl sm:text-4xl font-black tracking-wider text-slate-100 uppercase\">\n                {theme.title}\n              </h3>\n            </div>\n\n            {/* Tactical Specs Tag Box */}\n            <div className=\"bg-black/60 border border-slate-700 p-3 clip-chamfer font-mono text-[11px] space-y-1 sm:text-right\">\n              <div><span className=\"text-slate-500\">COMPLEXITY: </span><span className=\"text-amber-400\">{theme.tacticalSpecs.complexity}</span></div>\n              <div><span className=\"text-slate-500\">SECTOR: </span><span className=\"text-cyan-400\">{theme.tacticalSpecs.deploymentSector}</span></div>\n              <div><span className=\"text-slate-500\">FREQ: </span><span className=\"text-red-400\">{theme.tacticalSpecs.matrixFrequency}</span></div>\n            </div>\n          </div>\n\n          {/* 4 CORE TACTICAL CATEGORIES GRID */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 font-sans\">\n            {/* 1. DOMAIN OVERVIEW */}\n            <div className=\"bg-[#0b1424]/80 border border-slate-800 p-5 clip-chamfer\">\n              <div className=\"flex items-center gap-2 font-mono text-xs font-bold text-cyan-400 tracking-wider mb-2 font-orbitron\">\n                <Terminal className=\"w-4 h-4 text-cyan-400\" />\n                <span>DOMAIN OVERVIEW [MISSION DATA]</span>\n              </div>\n              <p className=\"text-sm text-slate-300 leading-relaxed\">\n                {theme.domainOverview}\n              </p>\n            </div>\n\n            {/* 2. POTENTIAL IMPACT */}\n            <div className=\"bg-[#0b1424]/80 border border-slate-800 p-5 clip-chamfer\">\n              <div className=\"flex items-center gap-2 font-mono text-xs font-bold text-red-400 tracking-wider mb-2 font-orbitron\">\n                <Zap className=\"w-4 h-4 text-red-500\" />\n                <span>POTENTIAL IMPACT [IMPACT VECTOR]</span>\n              </div>\n              <p className=\"text-sm text-slate-300 leading-relaxed\">\n                {theme.potentialImpact}\n              </p>\n            </div>\n\n            {/* 3. FOCUS AREAS */}\n            <div className=\"bg-[#0b1424]/80 border border-slate-800 p-5 clip-chamfer\">\n              <div className=\"flex items-center gap-2 font-mono text-xs font-bold text-amber-400 tracking-wider mb-3 font-orbitron\">\n                <Target className=\"w-4 h-4 text-amber-400\" />\n                <span>FOCUS AREAS [TARGET OBJECTIVES]</span>\n              </div>\n              <ul className=\"space-y-2 text-xs sm:text-sm text-slate-300 font-sans\">\n                {theme.focusAreas.map((area, idx) => (\n                  <li key={idx} className=\"flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" />\n                    <span>{area}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* 4. TECHNOLOGY DOMAINS */}\n            <div className=\"bg-[#0b1424]/80 border border-slate-800 p-5 clip-chamfer\">\n              <div className=\"flex items-center gap-2 font-mono text-xs font-bold text-blue-400 tracking-wider mb-3 font-orbitron\">\n                <Cpu className=\"w-4 h-4 text-blue-400\" />\n                <span>TECHNOLOGY DOMAINS [TECH STACK]</span>\n              </div>\n              <div className=\"flex flex-wrap gap-2\">\n                {theme.technologyDomains.map((tech, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-3 py-1 bg-slate-900 border border-cyan-500/40 text-cyan-300 font-mono text-xs clip-chamfer\"\n                  >\n                    {tech}\n                  </span>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Bottom Theme Navigation Quick Switcher */}\n          <div className=\"mt-8 pt-4 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4\">\n            <span className=\"font-mono text-xs text-slate-400\">\n              SWITCH MATRIX DOMAIN:\n            </span>\n            <div className=\"flex flex-wrap gap-2\">\n              {allThemes.map((item) => (\n                <button\n                  key={item.id}\n                  onClick={() => {\n                    playTransformation();\n                    onSelectAnother(item.id);\n                  }}\n                  className={`px-3 py-1 text-xs font-mono clip-chamfer transition-colors cursor-pointer ${\n                    item.id === theme.id\n                      ? \'bg-red-600 text-white font-bold\'\n                      : \'bg-slate-900 text-slate-400 hover:text-cyan-300 hover:bg-slate-800\'\n                  }`}\n                >\n                  #{item.number}\n                </button>\n              ))}\n            </div>\n          </div>\n        </motion.div>"
