    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <section id=\"register\" className=\"relative py-28 px-4 bg-[#04060c] overflow-hidden\">\n      {/* Background Energy Matrix */}\n      <div className=\"absolute inset-0 bg-cyber-grid opacity-25 pointer-events-none\" />\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-red-950/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-5xl mx-auto relative z-10 text-center flex flex-col items-center\">\n        {/* Top Command Pill */}\n        <div className=\"flex items-center gap-2 px-3.5 py-1 bg-[#091122] border border-red-500/50 clip-chamfer mb-4\">\n          <Zap className=\"w-3.5 h-3.5 text-red-500 animate-pulse\" />\n          <span className=\"font-mono text-xs text-red-400 tracking-widest font-semibold uppercase\">\n            SECTION 04 // REGISTRATION CONSOLE\n          </span>\n        </div>\n\n        <h2 className=\"font-orbitron font-black text-4xl sm:text-6xl tracking-wider text-slate-100 uppercase\">\n          COMMENCE <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-cyan-400\">TRANSFORMATION</span>\n        </h2>\n\n        <p className=\"mt-4 max-w-xl text-slate-300 font-sans text-base sm:text-lg\">\n          Secure your squad\342\200\231s slot in the national arena. Register your team credentials and join the revolution.\n        </p>\n\n        {/* TRANSFORMATION CONTROL PANEL (BIG BUTTON HOUSING) */}\n        <div className=\"mt-12 w-full max-w-2xl bg-[#09101d]/90 backdrop-blur-lg border-2 border-slate-700 p-8 sm:p-12 clip-chamfer-lg shadow-[0_0_50px_rgba(0,0,0,0.9)] relative group\">\n          {/* Hydraulic Safety Lock Brackets */}\n          <div className=\"absolute top-3 left-4 flex items-center gap-2 text-slate-500 font-mono text-[10px]\">\n            <Lock className=\"w-3 h-3 text-red-400\" />\n            <span>HYDRAULIC_CLAMPS: DISENGAGED</span>\n          </div>\n\n          <div className=\"absolute top-3 right-4 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n            <span className=\"font-mono text-[10px] text-emerald-400 font-semibold\">FORM_LINK_READY</span>\n          </div>\n\n          {/* THE GIANT TRANSFORMATION CONTROL BUTTON */}\n          <div className=\"my-6\">\n            <button\n              onClick={handleRegisterClick}\n              onMouseEnter={() => {\n                setIsHovered(true);\n                playHover();\n                playEnergyCharge();\n              }}\n              onMouseLeave={() => setIsHovered(false)}\n              className=\"relative w-full py-6 sm:py-8 bg-gradient-to-r from-red-700 via-red-600 to-red-800 hover:from-cyan-600 hover:via-blue-600 hover:to-red-600 text-white font-orbitron font-black text-xl sm:text-2xl tracking-widest clip-chamfer-lg shadow-[0_0_35px_rgba(239,68,68,0.7)] hover:shadow-[0_0_50px_rgba(0,240,255,0.9)] transition-all duration-500 cursor-pointer flex items-center justify-center gap-4 border-2 border-red-400 hover:border-cyan-300 group/btn\"\n            >\n              {/* Mechanical Plate Accent Layers */}\n              <div\n                className={`absolute inset-0 bg-hazard-stripes opacity-20 pointer-events-none transition-opacity duration-300 ${\n                  isHovered ? \'opacity-40\' : \'opacity-20\'\n                }`}\n              />\n\n              {/* Dynamic Transforming Text and Icons */}\n              {isHovered ? (\n                <div className=\"relative z-10 flex items-center gap-3 text-cyan-200 animate-pulse font-black\">\n                  <span>PROCEED</span>\n                  <ArrowRight className=\"w-7 h-7 translate-x-2 transition-transform\" />\n                </div>\n              ) : (\n                <div className=\"relative z-10 flex items-center gap-3\">\n                  <Zap className=\"w-6 h-6 text-amber-300\" />\n                  <span>INITIATE REGISTRATION</span>\n                  <ExternalLink className=\"w-5 h-5 text-red-200\" />\n                </div>\n              )}\n            </button>\n          </div>\n\n          {/* Form URL Placeholder Indicator Notice */}\n          <div className=\"mt-4 p-3 bg-black/60 border border-slate-800 rounded font-mono text-xs text-slate-400 flex flex-wrap items-center justify-between gap-2\">\n            <div className=\"flex items-center gap-2\">\n              <FileText className=\"w-4 h-4 text-cyan-400\" />\n              <span>OFFICIAL GOOGLE FORM LINK DESTINATION</span>\n            </div>\n            <span className=\"text-cyan-400 truncate max-w-xs\">{GOOGLE_FORM_URL}</span>\n          </div>\n\n          {/* 3 SQUAD PROTOCOL CRITERIA PILLARS */}\n          <div className=\"mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-800/80 text-left\">\n            <div className=\"bg-[#050912] p-3.5 border border-slate-800 clip-chamfer\">\n              <div className=\"flex items-center gap-1.5 text-cyan-400 font-mono text-xs font-bold mb-1\">\n                <Users className=\"w-3.5 h-3.5\" />\n                <span>SQUAD SIZE</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">1 to 4 Operatives per Unit</p>\n            </div>\n\n            <div className=\"bg-[#050912] p-3.5 border border-slate-800 clip-chamfer\">\n              <div className=\"flex items-center gap-1.5 text-red-400 font-mono text-xs font-bold mb-1\">\n                <Shield className=\"w-3.5 h-3.5\" />\n                <span>ENTRY FEE</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">100% Free // Zero Charge</p>\n            </div>\n\n            <div className=\"bg-[#050912] p-3.5 border border-slate-800 clip-chamfer\">\n              <div className=\"flex items-center gap-1.5 text-amber-400 font-mono text-xs font-bold mb-1\">\n                <Cpu className=\"w-3.5 h-3.5\" />\n                <span>ELIGIBILITY</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">All Tech Students & Builders</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>"
      replacement_content: "    <section id=\"register\" className=\"relative py-28 px-4 bg-[#05070a] border-t border-[#1e293b] overflow-hidden\">\n      {/* Background Energy Matrix */}\n      <div className=\"absolute inset-0 bg-sophisticated-radial opacity-20 pointer-events-none\" />\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-red-950/15 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-5xl mx-auto relative z-10 text-center flex flex-col items-center\">\n        {/* Top Command Pill */}\n        <div className=\"text-[10px] font-mono tracking-[0.4em] text-[#cc0000] mb-3 flex items-center justify-center gap-3 uppercase\">\n          <span className=\"w-8 h-[1px] bg-[#cc0000]/40\" />\n          <span>SECTION 04 // REGISTRATION CONSOLE</span>\n          <span className=\"w-8 h-[1px] bg-[#cc0000]/40\" />\n        </div>\n\n        <h2 className=\"font-orbitron font-black text-4xl sm:text-6xl tracking-wider text-white uppercase\">\n          COMMENCE <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-[#cc0000] via-amber-400 to-[#00A3FF]\">TRANSFORMATION</span>\n        </h2>\n\n        <p className=\"mt-4 max-w-xl text-gray-400 font-sans text-base sm:text-lg\">\n          Secure your squad\342\200\231s slot in the national arena. Register your team credentials and join the revolution.\n        </p>\n\n        {/* TRANSFORMATION CONTROL PANEL (BIG BUTTON HOUSING) */}\n        <div className=\"mt-12 w-full max-w-2xl bg-[#0a0f1d] border-2 border-[#1e293b] p-8 sm:p-12 clip-chamfer-lg shadow-[0_4px_40px_rgba(0,0,0,0.9)] relative group\">\n          {/* Hydraulic Safety Lock Brackets */}\n          <div className=\"absolute top-3 left-4 flex items-center gap-2 text-gray-500 font-mono text-[10px]\">\n            <Lock className=\"w-3 h-3 text-[#cc0000]\" />\n            <span>HYDRAULIC_CLAMPS: DISENGAGED</span>\n          </div>\n\n          <div className=\"absolute top-3 right-4 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n            <span className=\"font-mono text-[10px] text-emerald-400 font-semibold\">FORM_LINK_READY</span>\n          </div>\n\n          {/* THE GIANT TRANSFORMATION CONTROL BUTTON */}\n          <div className=\"my-6\">\n            <button\n              onClick={handleRegisterClick}\n              onMouseEnter={() => {\n                setIsHovered(true);\n                playHover();\n                playEnergyCharge();\n              }}\n              onMouseLeave={() => setIsHovered(false)}\n              className=\"relative w-full py-6 sm:py-8 bg-[#cc0000] hover:bg-[#b30000] text-white font-orbitron font-black text-xl sm:text-2xl tracking-[0.2em] clip-chamfer-lg shadow-[0_0_30px_rgba(204,0,0,0.6)] hover:shadow-[0_0_40px_rgba(0,163,255,0.7)] transition-all duration-300 cursor-pointer flex items-center justify-center gap-4 border border-white/20 hover:border-[#00A3FF] group/btn\"\n            >\n              {/* Dynamic Transforming Text and Icons */}\n              {isHovered ? (\n                <div className=\"relative z-10 flex items-center gap-3 text-white animate-pulse font-black\">\n                  <span>PROCEED TO FORM</span>\n                  <ArrowRight className=\"w-7 h-7 translate-x-2 transition-transform text-[#00A3FF]\" />\n                </div>\n              ) : (\n                <div className=\"relative z-10 flex items-center gap-3\">\n                  <Zap className=\"w-6 h-6 text-amber-300\" />\n                  <span>INITIATE REGISTRATION</span>\n                  <ExternalLink className=\"w-5 h-5 text-white/80\" />\n                </div>\n              )}\n            </button>\n          </div>\n\n          {/* Form URL Placeholder Indicator Notice */}\n          <div className=\"mt-4 p-3 bg-black/60 border border-[#1e293b] font-mono text-xs text-gray-400 flex flex-wrap items-center justify-between gap-2\">\n            <div className=\"flex items-center gap-2\">\n              <FileText className=\"w-4 h-4 text-[#00A3FF]\" />\n              <span>OFFICIAL GOOGLE FORM DESTINATION</span>\n            </div>\n            <span className=\"text-[#00A3FF] truncate max-w-xs\">{GOOGLE_FORM_URL}</span>\n          </div>\n\n          {/* 3 SQUAD PROTOCOL CRITERIA PILLARS */}\n          <div className=\"mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-[#1e293b] text-left\">\n            <div className=\"bg-[#05070a] p-3.5 border border-[#1e293b] clip-chamfer\">\n              <div className=\"flex items-center gap-1.5 text-[#00A3FF] font-mono text-xs font-bold mb-1\">\n                <Users className=\"w-3.5 h-3.5\" />\n                <span>SQUAD SIZE</span>\n              </div>\n              <p className=\"text-xs text-gray-300\">1 to 4 Operatives per Unit</p>\n            </div>\n\n            <div className=\"bg-[#05070a] p-3.5 border border-[#1e293b] clip-chamfer\">\n              <div className=\"flex items-center gap-1.5 text-[#cc0000] font-mono text-xs font-bold mb-1\">\n                <Shield className=\"w-3.5 h-3.5\" />\n                <span>ENTRY FEE</span>\n              </div>\n              <p className=\"text-xs text-gray-300\">100% Free // Zero Charge</p>\n            </div>\n\n            <div className=\"bg-[#05070a] p-3.5 border border-[#1e293b] clip-chamfer\">\n              <div className=\"flex items-center gap-1.5 text-amber-400 font-mono text-xs font-bold mb-1\">\n                <Cpu className=\"w-3.5 h-3.5\" />\n                <span>ELIGIBILITY</span>\n              </div>\n              <p className=\"text-xs text-gray-300\">All Tech Students & Builders</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>"
