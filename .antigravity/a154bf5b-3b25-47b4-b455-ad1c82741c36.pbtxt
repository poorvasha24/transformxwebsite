    instruction: "Update RobotCommanderGuide.tsx with Sophisticated Dark theme bubble, accents, and avatar chassis styling"
    replacement_infos {
      original_chunk {
        target_content: "      <AnimatePresence>\n        {!isMinimized && (\n          <motion.div\n            className=\"mb-3 max-w-sm sm:max-w-md w-full bg-[#080e1b]/95 backdrop-blur-md border-2 border-cyan-500/70 p-4 shadow-[0_0_25px_rgba(0,240,255,0.3)] clip-chamfer pointer-events-auto\"\n            initial={{ opacity: 0, y: 20, scale: 0.9 }}\n            animate={{ opacity: 1, y: 0, scale: 1 }}\n            exit={{ opacity: 0, y: 20, scale: 0.9 }}\n            transition={{ duration: 0.2 }}\n          >\n            {/* Speech Bubble Header */}\n            <div className=\"flex items-center justify-between pb-2 mb-2 border-b border-cyan-500/30\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-2 h-2 rounded-full bg-cyan-400 animate-ping\" />\n                <span className=\"font-mono text-[10px] sm:text-xs text-cyan-300 tracking-wider font-bold\">\n                  PRIME_COMMANDER // {script.title}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  onClick={() => setIsMutedVoice(!isMutedVoice)}\n                  title=\"Toggle Commander Voice\"\n                  className=\"p-1 text-slate-400 hover:text-cyan-300 transition-colors cursor-pointer\"\n                >\n                  {isMutedVoice ? <VolumeX className=\"w-3.5 h-3.5\" /> : <Volume2 className=\"w-3.5 h-3.5 text-cyan-400\" />}\n                </button>\n                <button\n                  onClick={() => {\n                    playClick();\n                    setIsMinimized(true);\n                  }}\n                  title=\"Minimize Commander\"\n                  className=\"p-1 text-slate-400 hover:text-red-400 transition-colors cursor-pointer\"\n                >\n                  <X className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Speech Text Content */}\n            <div className=\"min-h-[48px] flex items-center font-mono text-xs sm:text-sm text-slate-100 tracking-wide leading-relaxed\">\n              <span className=\"text-red-500 font-bold mr-1\">&gt;</span>\n              <span>{displayedText}</span>\n              {isTyping && <span className=\"inline-block w-2 h-3.5 bg-cyan-400 ml-1 animate-pulse\" />}\n            </div>\n\n            {/* Speech Bubble Footer Controls */}\n            <div className=\"mt-3 flex items-center justify-between pt-2 border-t border-slate-800/80\">\n              <span className=\"font-mono text-[9px] text-slate-400 tracking-widest\">\n                LOG: {activeLineIndex + 1}/{script.lines.length}\n              </span>\n              <button\n                onClick={handleNextLine}\n                className=\"flex items-center gap-1 px-3 py-1 bg-cyan-950/80 hover:bg-cyan-900 border border-cyan-500/50 text-cyan-300 hover:text-white text-[10px] font-mono tracking-wider clip-chamfer transition-all cursor-pointer\"\n              >\n                <span>NEXT INTEL</span>\n                <ChevronRight className=\"w-3 h-3\" />\n              </button>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* PIXELATED ROBOTIC COMMANDER SPRITE & MINIMIZED TOGGLE */}\n      <div className=\"flex items-center gap-2 pointer-events-auto\">\n        <button\n          onClick={() => {\n            playUiBeep(920);\n            setIsMinimized(!isMinimized);\n          }}\n          className=\"group relative cursor-pointer focus:outline-none\"\n          title=\"Toggle Tactical Commander Guide\"\n        >\n          {/* Ambient Glow Aura */}\n          <div className=\"absolute inset-0 rounded-lg bg-cyan-500/20 group-hover:bg-red-500/30 blur-md transition-colors\" />\n\n          {/* Commander Character Chassis */}\n          <div className=\"relative w-16 h-16 sm:w-20 sm:h-20 bg-[#09101d] border-2 border-cyan-400/80 group-hover:border-red-500 p-1 clip-chamfer shadow-[0_0_15px_rgba(0,240,255,0.4)] transition-all duration-300\">\n            {/* SVG PIXEL-ART ROBOTIC COMMANDER (Optimus Prime aesthetic silhouette) */}\n            <svg\n              viewBox=\"0 0 32 32\"\n              className=\"w-full h-full [image-rendering:pixelated]\"\n              style={{ shapeRendering: \'crispEdges\' }}\n            >\n              {/* Antenna Ears (Silver / Blue) */}\n              <rect x=\"6\" y=\"2\" width=\"2\" height=\"7\" fill=\"#64748b\" />\n              <rect x=\"24\" y=\"2\" width=\"2\" height=\"7\" fill=\"#64748b\" />\n              <rect x=\"7\" y=\"1\" width=\"1\" height=\"2\" fill=\"#00f0ff\" />\n              <rect x=\"24\" y=\"1\" width=\"1\" height=\"2\" fill=\"#00f0ff\" />\n\n              {/* Helmet Crown (Heroic Royal Blue) */}\n              <rect x=\"10\" y=\"3\" width=\"12\" height=\"4\" fill=\"#1d4ed8\" />\n              <rect x=\"12\" y=\"1\" width=\"8\" height=\"3\" fill=\"#2563eb\" />\n              <rect x=\"15\" y=\"0\" width=\"2\" height=\"3\" fill=\"#93c5fd\" />\n\n              {/* Head Base / Temples */}\n              <rect x=\"8\" y=\"7\" width=\"16\" height=\"8\" fill=\"#1e40af\" />\n              <rect x=\"9\" y=\"8\" width=\"14\" height=\"2\" fill=\"#1e3a8a\" />\n\n              {/* Glowing Optic Visor Eyes (Cybernetic Cyan / Golden) */}\n              <rect x=\"10\" y=\"10\" width=\"4\" height=\"2\" fill=\"#00f0ff\" />\n              <rect x=\"18\" y=\"10\" width=\"4\" height=\"2\" fill=\"#00f0ff\" />\n              <rect x=\"11\" y=\"10\" width=\"2\" height=\"1\" fill=\"#ffffff\" />\n              <rect x=\"19\" y=\"10\" width=\"2\" height=\"1\" fill=\"#ffffff\" />\n\n              {/* Faceplate / Mouth Guard (Silver Gunmetal with Ribs) */}\n              <polygon points=\"12,12 20,12 18,17 14,17\" fill=\"#94a3b8\" />\n              <rect x=\"13\" y=\"13\" width=\"6\" height=\"1\" fill=\"#475569\" />\n              <rect x=\"14\" y=\"15\" width=\"4\" height=\"1\" fill=\"#334155\" />\n\n              {/* Crimson Red Shoulder Armor Plates */}\n              <rect x=\"3\" y=\"18\" width=\"6\" height=\"7\" fill=\"#dc2626\" />\n              <rect x=\"23\" y=\"18\" width=\"6\" height=\"7\" fill=\"#dc2626\" />\n              <rect x=\"4\" y=\"17\" width=\"4\" height=\"2\" fill=\"#ef4444\" />\n              <rect x=\"24\" y=\"17\" width=\"4\" height=\"2\" fill=\"#ef4444\" />\n\n              {/* Chestplate Armor (Crimson Red with Matrix of Leadership Core) */}\n              <rect x=\"9\" y=\"18\" width=\"14\" height=\"10\" fill=\"#b91c1c\" />\n              <rect x=\"10\" y=\"19\" width=\"5\" height=\"4\" fill=\"#ef4444\" />\n              <rect x=\"17\" y=\"19\" width=\"5\" height=\"4\" fill=\"#ef4444\" />\n\n              {/* Glowing Center Power Matrix */}\n              <rect x=\"14\" y=\"21\" width=\"4\" height=\"4\" fill=\"#00f0ff\" />\n              <rect x=\"15\" y=\"22\" width=\"2\" height=\"2\" fill=\"#ffffff\" />\n\n              {/* Abdominal Silver Grille / Vents */}\n              <rect x=\"11\" y=\"25\" width=\"10\" height=\"4\" fill=\"#334155\" />\n              <rect x=\"12\" y=\"26\" width=\"8\" height=\"1\" fill=\"#64748b\" />\n              <rect x=\"12\" y=\"28\" width=\"8\" height=\"1\" fill=\"#64748b\" />\n\n              {/* Waist Plate */}\n              <rect x=\"10\" y=\"29\" width=\"12\" height=\"3\" fill=\"#1e293b\" />\n              <rect x=\"14\" y=\"29\" width=\"4\" height=\"2\" fill=\"#eab308\" />\n            </svg>\n\n            {/* Online Status Dot */}\n            <div className=\"absolute top-1 right-1 w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-pulse\" />\n          </div>\n\n          {/* Unread Alert Ping when minimized */}\n          {isMinimized && (\n            <motion.div\n              className=\"absolute -top-1 -right-1 w-4 h-4 rounded-full bg-red-500 flex items-center justify-center text-[9px] font-bold text-white border border-black shadow-[0_0_10px_#ef4444]\"\n              initial={{ scale: 0 }}\n              animate={{ scale: 1 }}\n              transition={{ repeat: Infinity, repeatType: \'reverse\', duration: 1 }}\n            >\n              !\n            </motion.div>\n          )}\n        </button>\n      </div>"
        replacement_content: "      <AnimatePresence>\n        {!isMinimized && (\n          <motion.div\n            className=\"mb-3 max-w-sm sm:max-w-md w-full bg-black/75 border border-[#00A3FF]/40 p-4 backdrop-blur-md relative clip-commander-bubble shadow-[0_0_30px_rgba(0,0,0,0.9)] pointer-events-auto\"\n            initial={{ opacity: 0, y: 20, scale: 0.95 }}\n            animate={{ opacity: 1, y: 0, scale: 1 }}\n            exit={{ opacity: 0, y: 20, scale: 0.95 }}\n            transition={{ duration: 0.2 }}\n          >\n            {/* Top-Right Square Accent */}\n            <div className=\"absolute -top-1 -right-1 w-2 h-2 bg-[#00A3FF]\" />\n\n            {/* Speech Bubble Header */}\n            <div className=\"flex items-center justify-between pb-2 mb-2 border-b border-[#00A3FF]/20\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-1.5 h-1.5 rounded-full bg-[#00A3FF] animate-ping\" />\n                <span className=\"text-[9px] font-mono text-[#00A3FF] tracking-widest uppercase font-bold\">\n                  PRIME_COMMANDER // {script.title}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  onClick={() => setIsMutedVoice(!isMutedVoice)}\n                  title=\"Toggle Commander Voice\"\n                  className=\"p-1 text-gray-400 hover:text-[#00A3FF] transition-colors cursor-pointer\"\n                >\n                  {isMutedVoice ? <VolumeX className=\"w-3.5 h-3.5\" /> : <Volume2 className=\"w-3.5 h-3.5 text-[#00A3FF]\" />}\n                </button>\n                <button\n                  onClick={() => {\n                    playClick();\n                    setIsMinimized(true);\n                  }}\n                  title=\"Minimize Commander\"\n                  className=\"p-1 text-gray-400 hover:text-[#cc0000] transition-colors cursor-pointer\"\n                >\n                  <X className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Speech Text Content */}\n            <div className=\"min-h-[44px] flex items-center font-mono text-xs text-gray-300 tracking-wide leading-relaxed\">\n              <span className=\"text-[#cc0000] font-bold mr-1.5\">&gt;</span>\n              <span>{displayedText}</span>\n              {isTyping && <span className=\"inline-block w-2 h-3 bg-[#00A3FF] ml-1 animate-pulse\" />}\n            </div>\n\n            {/* Speech Bubble Footer Controls */}\n            <div className=\"mt-3 flex items-center justify-between pt-2 border-t border-[#1e293b]\">\n              <span className=\"font-mono text-[9px] text-gray-500 tracking-widest\">\n                LOG: {activeLineIndex + 1}/{script.lines.length}\n              </span>\n              <button\n                onClick={handleNextLine}\n                className=\"flex items-center gap-1 px-3 py-1 bg-[#0a0f1d] hover:bg-[#121a30] border border-[#00A3FF]/40 text-[#00A3FF] hover:text-white text-[9px] font-mono tracking-wider transition-all cursor-pointer\"\n              >\n                <span>NEXT INTEL</span>\n                <ChevronRight className=\"w-3 h-3\" />\n              </button>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* PIXELATED ROBOTIC COMMANDER SPRITE & MINIMIZED TOGGLE */}\n      <div className=\"flex items-center gap-2 pointer-events-auto\">\n        <button\n          onClick={() => {\n            playUiBeep(920);\n            setIsMinimized(!isMinimized);\n          }}\n          className=\"group relative cursor-pointer focus:outline-none\"\n          title=\"Toggle Tactical Commander Guide\"\n        >\n          {/* Ambient Glow Aura */}\n          <div className=\"absolute inset-0 bg-[#00A3FF]/20 group-hover:bg-[#cc0000]/30 blur-md transition-colors\" />\n\n          {/* Commander Character Chassis (Octagon Frame + Corner Accent) */}\n          <div className=\"relative w-16 h-16 sm:w-20 sm:h-20 bg-gray-900 border-2 border-[#00A3FF] group-hover:border-[#cc0000] p-1 clip-octagon shadow-[0_0_20px_rgba(0,163,255,0.4)] transition-all duration-300 flex items-center justify-center\">\n            {/* Square Corner Accent */}\n            <div className=\"absolute -bottom-1 -left-1 w-2 h-2 bg-[#cc0000]\" />\n\n            {/* SVG PIXEL-ART ROBOTIC COMMANDER */}\n            <svg\n              viewBox=\"0 0 32 32\"\n              className=\"w-full h-full [image-rendering:pixelated]\"\n              style={{ shapeRendering: \'crispEdges\' }}\n            >\n              {/* Antenna Ears (Silver / Blue) */}\n              <rect x=\"6\" y=\"2\" width=\"2\" height=\"7\" fill=\"#64748b\" />\n              <rect x=\"24\" y=\"2\" width=\"2\" height=\"7\" fill=\"#64748b\" />\n              <rect x=\"7\" y=\"1\" width=\"1\" height=\"2\" fill=\"#00A3FF\" />\n              <rect x=\"24\" y=\"1\" width=\"1\" height=\"2\" fill=\"#00A3FF\" />\n\n              {/* Helmet Crown (Heroic Royal Blue) */}\n              <rect x=\"10\" y=\"3\" width=\"12\" height=\"4\" fill=\"#1d4ed8\" />\n              <rect x=\"12\" y=\"1\" width=\"8\" height=\"3\" fill=\"#2563eb\" />\n              <rect x=\"15\" y=\"0\" width=\"2\" height=\"3\" fill=\"#93c5fd\" />\n\n              {/* Head Base / Temples */}\n              <rect x=\"8\" y=\"7\" width=\"16\" height=\"8\" fill=\"#1e40af\" />\n              <rect x=\"9\" y=\"8\" width=\"14\" height=\"2\" fill=\"#1e3a8a\" />\n\n              {/* Glowing Optic Visor Eyes (Cybernetic Cyan / Golden) */}\n              <rect x=\"10\" y=\"10\" width=\"4\" height=\"2\" fill=\"#00A3FF\" />\n              <rect x=\"18\" y=\"10\" width=\"4\" height=\"2\" fill=\"#00A3FF\" />\n              <rect x=\"11\" y=\"10\" width=\"2\" height=\"1\" fill=\"#ffffff\" />\n              <rect x=\"19\" y=\"10\" width=\"2\" height=\"1\" fill=\"#ffffff\" />\n\n              {/* Faceplate / Mouth Guard (Silver Gunmetal with Ribs) */}\n              <polygon points=\"12,12 20,12 18,17 14,17\" fill=\"#94a3b8\" />\n              <rect x=\"13\" y=\"13\" width=\"6\" height=\"1\" fill=\"#475569\" />\n              <rect x=\"14\" y=\"15\" width=\"4\" height=\"1\" fill=\"#334155\" />\n\n              {/* Crimson Red Shoulder Armor Plates */}\n              <rect x=\"3\" y=\"18\" width=\"6\" height=\"7\" fill=\"#cc0000\" />\n              <rect x=\"23\" y=\"18\" width=\"6\" height=\"7\" fill=\"#cc0000\" />\n              <rect x=\"4\" y=\"17\" width=\"4\" height=\"2\" fill=\"#ef4444\" />\n              <rect x=\"24\" y=\"17\" width=\"4\" height=\"2\" fill=\"#ef4444\" />\n\n              {/* Chestplate Armor */}\n              <rect x=\"9\" y=\"18\" width=\"14\" height=\"10\" fill=\"#990000\" />\n              <rect x=\"10\" y=\"19\" width=\"5\" height=\"4\" fill=\"#cc0000\" />\n              <rect x=\"17\" y=\"19\" width=\"5\" height=\"4\" fill=\"#cc0000\" />\n\n              {/* Glowing Center Power Matrix */}\n              <rect x=\"14\" y=\"21\" width=\"4\" height=\"4\" fill=\"#00A3FF\" />\n              <rect x=\"15\" y=\"22\" width=\"2\" height=\"2\" fill=\"#ffffff\" />\n\n              {/* Abdominal Silver Grille / Vents */}\n              <rect x=\"11\" y=\"25\" width=\"10\" height=\"4\" fill=\"#334155\" />\n              <rect x=\"12\" y=\"26\" width=\"8\" height=\"1\" fill=\"#64748b\" />\n              <rect x=\"12\" y=\"28\" width=\"8\" height=\"1\" fill=\"#64748b\" />\n\n              {/* Waist Plate */}\n              <rect x=\"10\" y=\"29\" width=\"12\" height=\"3\" fill=\"#1e293b\" />\n              <rect x=\"14\" y=\"29\" width=\"4\" height=\"2\" fill=\"#eab308\" />\n            </svg>\n\n            {/* Online Status Dot */}\n            <div className=\"absolute top-1 right-1 w-2 h-2 rounded-full bg-[#00A3FF] shadow-[0_0_8px_#00A3FF] animate-pulse\" />\n          </div>\n\n          {/* Unread Alert Ping when minimized */}\n          {isMinimized && (\n  