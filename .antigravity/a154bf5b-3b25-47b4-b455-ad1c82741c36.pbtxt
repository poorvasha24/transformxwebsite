    instruction: "Update Navbar.tsx with Sophisticated Dark theme header, sound switch, brand badge, and nav link styles"
    replacement_infos {
      original_chunk {
        target_content: "export const Navbar: React.FC<NavbarProps> = ({\n  activeSection,\n  onNavigate,\n  onReplayIntro,\n}) => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [isSoundOn, setIsSoundOn] = useState(getSoundEnabled());\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 40);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navItems = [\n    { id: \'hero\', label: \'HOME\', code: \'00\' },\n    { id: \'event\', label: \'EVENT\', code: \'01\' },\n    { id: \'themes\', label: \'THEMES\', code: \'02\' },\n    { id: \'roadmap\', label: \'ROADMAP\', code: \'03\' },\n    { id: \'register\', label: \'REGISTER\', code: \'04\' },\n  ];\n\n  const handleSoundToggle = () => {\n    const nextState = !isSoundOn;\n    setIsSoundOn(nextState);\n    setSoundEnabled(nextState);\n    if (nextState) {\n      playUiBeep(1200);\n    }\n  };\n\n  const handleItemClick = (id: string) => {\n    playClick();\n    onNavigate(id);\n    setIsMobileMenuOpen(false);\n  };\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 px-3 sm:px-8 pt-3 sm:pt-5 transition-all duration-300 pointer-events-none\">\n      <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n        {/* BRAND LOGO: TRANSFORMX (Mechanical Emblem) */}\n        <div\n          onClick={() => handleItemClick(\'hero\')}\n          onMouseEnter={playHover}\n          className=\"pointer-events-auto flex items-center gap-3 bg-[#080d19]/90 backdrop-blur-md border-2 border-cyan-500/60 hover:border-red-500 px-4 py-2 clip-chamfer cursor-pointer shadow-[0_0_20px_rgba(0,240,255,0.25)] group transition-all\"\n        >\n          {/* Autobot-Inspired Mechanical Crest */}\n          <div className=\"w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center bg-gradient-to-br from-red-600 to-red-900 border border-red-400 clip-chamfer group-hover:scale-105 transition-transform shadow-[0_0_10px_rgba(239,68,68,0.7)]\">\n            <Cpu className=\"w-4 h-4 text-cyan-200 animate-pulse\" />\n          </div>\n\n          <div className=\"flex flex-col\">\n            <span className=\"font-orbitron font-black text-base sm:text-lg tracking-widest text-slate-100 flex items-center\">\n              TRANSFORM<span className=\"text-red-500\">X</span>\n            </span>\n            <span className=\"font-mono text-[8px] text-cyan-400 tracking-wider uppercase -mt-1\">\n              HACKATHON // PROTOCOL 2026\n            </span>\n          </div>\n        </div>\n\n        {/* DESKTOP MECHANICAL HUD NAVIGATION */}\n        <nav className=\"hidden md:flex items-center gap-1.5 bg-[#090f1d]/90 backdrop-blur-lg border border-slate-700/80 px-3 py-1.5 clip-chamfer shadow-[0_0_25px_rgba(0,0,0,0.8)] pointer-events-auto relative\">\n          {/* Laser Scanning Beam moving across nav */}\n          <div className=\"absolute top-0 bottom-0 w-8 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent pointer-events-none animate-scanline opacity-50\" />\n\n          {navItems.map((item) => {\n            const isActive = activeSection === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => handleItemClick(item.id)}\n                onMouseEnter={playHover}\n                className={`relative px-4 py-2 font-orbitron text-xs tracking-wider transition-all duration-200 clip-chamfer flex items-center gap-2 cursor-pointer ${\n                  isActive\n                    ? \'bg-gradient-to-r from-red-950/80 to-[#101b33] text-cyan-300 border border-cyan-400 shadow-[0_0_15px_rgba(0,240,255,0.4)]\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 border border-transparent\'\n                }`}\n              >\n                <span className=\"font-mono text-[9px] text-red-400 opacity-70\">\n                  {item.code}\n                </span>\n                <span className=\"font-semibold\">{item.label}</span>\n                {isActive && (\n                  <motion.div\n                    layoutId=\"activeNavIndicator\"\n                    className=\"absolute bottom-0 left-2 right-2 h-0.5 bg-gradient-to-r from-red-500 via-cyan-400 to-red-500\"\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* RIGHT CONTROLS: SOUND TOGGLE & REPLAY INTRO */}\n        <div className=\"flex items-center gap-2 pointer-events-auto\">\n          {/* Replay Intro Button */}\n          <button\n            onClick={() => {\n              playClick();\n              onReplayIntro();\n            }}\n            onMouseEnter={playHover}\n            title=\"Replay Cinematic Intro Sequence\"\n            className=\"hidden sm:flex items-center gap-1.5 bg-[#0b1324] hover:bg-[#152342] text-slate-300 hover:text-cyan-300 px-3 py-2 border border-slate-700/80 hover:border-cyan-500/60 clip-chamfer transition-all text-xs font-mono tracking-wider cursor-pointer\"\n          >\n            <Play className=\"w-3.5 h-3.5 text-red-400 fill-red-400\" />\n            <span>INTRO</span>\n          </button>\n\n          {/* Sound Toggle HUD Button */}\n          <button\n            onClick={handleSoundToggle}\n            onMouseEnter={playHover}\n            className={`flex items-center gap-2 px-3.5 py-2 border clip-chamfer transition-all duration-200 text-xs font-mono tracking-wider cursor-pointer ${\n              isSoundOn\n                ? \'bg-[#0e213d] border-cyan-400 text-cyan-300 shadow-[0_0_15px_rgba(0,240,255,0.4)]\'\n                : \'bg-[#181a20] border-slate-700 text-slate-400 hover:border-slate-500\'\n            }`}\n          >\n            {isSoundOn ? (\n              <>\n                <Volume2 className=\"w-4 h-4 text-cyan-400 animate-pulse\" />\n                <span className=\"hidden sm:inline\">AUDIO: ON</span>\n                <div className=\"flex items-end gap-0.5 h-3\">\n                  <div className=\"w-0.5 h-2 bg-cyan-400 animate-pulse\" />\n                  <div className=\"w-0.5 h-3 bg-red-500 animate-pulse [animation-delay:150ms]\" />\n                  <div className=\"w-0.5 h-1.5 bg-cyan-400 animate-pulse [animation-delay:300ms]\" />\n                </div>\n              </>\n            ) : (\n              <>\n                <VolumeX className=\"w-4 h-4 text-red-400\" />\n                <span className=\"hidden sm:inline\">AUDIO: OFF</span>\n              </>\n            )}\n          </button>\n\n          {/* Mobile Hamburger Toggle */}\n          <button\n            onClick={() => {\n              playClick();\n              setIsMobileMenuOpen(!isMobileMenuOpen);\n            }}\n            className=\"md:hidden p-2 bg-[#090f1d] border border-cyan-500/50 text-cyan-400 clip-chamfer cursor-pointer\"\n          >\n            {isMobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* MOBILE EXPANDABLE COMMAND HUD MENU */}\n      {isMobileMenuOpen && (\n        <motion.div\n          initial={{ opacity: 0, y: -10 }}\n          animate={{ opacity: 1, y: 0 }}\n          exit={{ opacity: 0, y: -10 }}\n          className=\"md:hidden pointer-events-auto mt-2 mx-auto max-w-sm bg-[#090f1d]/98 backdrop-blur-xl border-2 border-cyan-500 p-4 clip-chamfer shadow-[0_10px_30px_rgba(0,0,0,0.9)]\"\n        >\n          <div className=\"flex flex-col gap-2\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => handleItemClick(item.id)}\n                className={`w-full py-2.5 px-4 font-orbitron text-sm tracking-widest text-left clip-chamfer flex items-center justify-between transition-colors ${\n                  activeSection === item.id\n                    ? \'bg-red-900/50 border border-red-500 text-white font-bold\'\n                    : \'bg-slate-900/60 hover:bg-slate-800 text-slate-300\'\n                }`}\n              >\n                <span>{item.label}</span>\n                <span className=\"font-mono text-xs text-cyan-400\">{item.code}</span>\n              </button>\n            ))}\n\n            <button\n              onClick={() => {\n                onReplayIntro();\n                setIsMobileMenuOpen(false);\n              }}\n              className=\"mt-2 w-full py-2 bg-slate-900 border border-slate-700 hover:border-cyan-400 text-slate-300 font-mono text-xs tracking-wider flex items-center justify-center gap-2 clip-chamfer\"\n            >\n              <Play className=\"w-3.5 h-3.5 text-red-500\" />\n              <span>REPLAY INTRO CINEMATIC</span>\n            </button>\n          </div>\n        </motion.div>\n      )}\n    </header>\n  );\n};"
        replacement_content: "export const Navbar: React.FC<NavbarProps> = ({\n  activeSection,\n  onNavigate,\n  onReplayIntro,\n}) => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [isSoundOn, setIsSoundOn] = useState(getSoundEnabled());\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 40);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navItems = [\n    { id: \'hero\', label: \'HOME\', code: \'00\' },\n    { id: \'event\', label: \'EVENT\', code: \'01\' },\n    { id: \'themes\', label: \'THEMES\', code: \'02\' },\n    { id: \'roadmap\', label: \'ROADMAP\', code: \'03\' },\n    { id: \'register\', label: \'REGISTER\', code: \'04\' },\n  ];\n\n  const handleSoundToggle = () => {\n    const nextState = !isSoundOn;\n    setIsSoundOn(nextState);\n    setSoundEnabled(nextState);\n    if (nextState) {\n      playUiBeep(1200);\n    }\n  };\n\n  const handleItemClick = (id: string) => {\n    playClick();\n    onNavigate(id);\n    setIsMobileMenuOpen(false);\n  };\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 transition-all duration-300 pointer-events-none bg-[#0a0f1d]/80 backdrop-blur-md border-b border-[#1e293b] px-4 sm:px-12 py-3 sm:py-0 sm:h-16 flex items-center justify-between\">\n      {/* BRAND LOGO: TRANSFORMX (Diamond Emblem) */}\n      <div\n        onClick={() => handleItemClick(\'hero\')}\n        onMouseEnter={playHover}\n        className=\"pointer-events-auto flex items-center gap-3 cursor-pointer group\"\n      >\n        {/* Diamond 45deg Emblem */}\n        <div className=\"w-7 h-7 sm:w-8 sm:h-8 bg-[#cc0000] rotate-45 flex items-center justify-center border border-white/20 shadow-[0_0_12px_rgba(204,0,0,0.6)] group-hover:scale-105 transition-transform\">\n          <div className=\"w-3.5 h-3.5 sm:w-4 sm:h-4 bg-white/10\" />\n        </div>\n\n        <div className=\"flex items-center\">\n          <span className=\"font-black tracking-[0.2em] text-lg sm:text-xl text-white font-orbitron\">\n            TRANSFORM<span className=\"text-[#cc0000]\">X</span>\n          </span>\n        </div>\n      </div>\n\n      {/* DESKTOP SOPHISTICATED NAV */}\n      <nav className=\"hidden md:flex items-center gap-8 pointer-events-auto\">\n        {navItems.map((item) => {\n          const isActive = activeSection === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => handleItemClick(item.id)}\n              onMouseEnter={playHover}\n              className={`text-[10px] uppercase tracking-[0.3em] font-bold transition-colors cursor-pointer py-1 font-mono ${\n                isActive\n                  ? \'text-[#00A3FF] border-b-2 border-[#00A3FF]\'\n                  : \'text-gray-500 hover:text-white border-b-2 border-transparent\'\n              }`}\n            >\n              {item.label}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* RIGHT CONTROLS: SOUND TOGGLE & REPLAY INTRO */}\n      <div className=\"flex items-center gap-4 sm:gap-6 pointer-events-auto\">\n        {/* Replay Intro Button */}\n        <button\n          onClick={() => {\n            playClick();\n            onReplayIntro();\n          }}\n          onMouseEnter={playHover}\n          title=\"Replay Cinematic Intro Sequence\"\n          className=\"hidden sm:flex items-center gap-1.5 border border-[#1e293b] hover:border-[#00A3FF]/60 px-3 py-1 bg-black/40 hover:bg-[#0a0f1d] text-gray-400 hover:text-white transition-all text-[9px] font-mono tracking-widest cursor-pointer\"\n        >\n          <Play className=\"w-3 h-3 text-[#cc0000] fill-[#cc0000]\" />\n          <span>INTRO</span>\n        </button>\n\n        {/* Sophisticated Dark Sound Toggle */}\n        <div\n          onClick={handleSoundToggle}\n          onMouseEnter={playHover}\n          className=\"flex items-center gap-2 border border-[#1e293b] px-3 py-1 bg-black/40 cursor-pointer hover:border-gray-700 transition-colors\"\n        >\n          <span className=\"text-[9px] font-mono text-gray-500 tracking-wider\">SOUND</span>\n          <div className=\"w-8 h-3 bg-[#00A3FF]/20 relative rounded-full transition-colors\">\n            <div\n              className={`absolute top-0 w-4 h-3 rounded-full transition-all duration-300 ${\n                isSoundOn\n                  ? \'right-0 bg-[#00A3FF] shadow-[0_0_8px_#00A3FF]\'\n                  : \'left-0 bg-gray-600\'\n              }`}\n            />\n          </div>\n          <span\n            className={`text-[9px] font-mono tracking-wider ${\n              isSoundOn ? \'text-[#00A3FF]\' : \'text-gray-600\'\n            }`}\n          >\n            {isSoundOn ? \'ON\' : \'OFF\'}\n          </span>\n        </div>\n\n        {/* Mobile Hamburger Toggle */}\n        <button\n          onClick={() => {\n            playClick();\n            setIsMobileMenuOpen(!isMobileMenuOpen);\n          }}\n          className=\"md:hidden p-1.5 bg-black/50 border border-[#1e293b] text-[#00A3FF] cursor-pointer\"\n        >\n          {isMobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n        </button>\n      </div>\n\n      {/* MOBILE EXPANDABLE COMMAND HUD MENU */}\n      {isMobileMenuOpen && (\n        <motion.div\n          initial={{ opacity: 0, y: -10 }}\n          animate={{ opacity: 1, y: 0 }}\n          exit={{ opacity: 0, y: -10 }}\n          className=\"md:hidden pointer-events-auto absolute top-full left-0 right-0 bg-[#0a0f1d]/98 backdrop-blur-xl border-b border-[#1e293b] p-4 shadow-[0_10px_30px_rgba(0,0,0,0.9)]\"\n        >\n          <div className=\"flex flex-col gap-2\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => handleItemClick(item.id)}\n                className={`w-full py-2 px-3 font-mono text-xs tracking-[0.2em] text-left uppercase transition-colors ${\n                  activeSection === item.id\n                    ? \'bg-[#00A3FF]/10 text-[#00A3FF] border-l-2 border-[#00A3FF] font-bold\'\n                    : \'text-gray-400 hover:text-white\'\n                }`}\n              >\n                <span>{item.label}</span>\n              </button>\n            ))}\n\n            <button\n              onClick={() => {\n                onReplayIntro();\n                setIsMobileMenuOpen(false);\n              }}\n              className=\"mt-2 w-full py-2 bg-black/60 border border-[#1e293b] text-gray-400 hover:text-white font-mono text-xs tracking-wider flex items-center justify-center gap-2\"\n            >\n              <Play className=\"w-3 h-3 text-[#cc0000]\" />\n              <span>REPLAY INTRO CINEMATIC</span>\n            </button>\n          </div>\n        </motion.div>\n      )}\n    </header>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
