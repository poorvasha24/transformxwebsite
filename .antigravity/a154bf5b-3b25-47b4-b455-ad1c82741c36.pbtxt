  file_change {
    absolute_path_uri: "file:///src/components/RoadmapTimeline.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport {\n  Radio,\n  Cpu,\n  ShieldAlert,\n  Zap,\n  CheckCircle2,\n  Calendar,\n  Clock,\n  Crosshair,\n  Flame,\n  Award,\n  Sparkles\n} from \'lucide-react\';\nimport { ROADMAP_MILESTONES } from \'../data/eventData\';\nimport { playHover, playServo, playUiBeep } from \'../utils/audio\';\n\nexport const RoadmapTimeline: React.FC = () => {\n  return (\n    <section id=\"roadmap\" className=\"relative py-24 px-4 bg-[#05070e] overflow-hidden\">\n      {/* Background Cybernetic Rail Grid */}\n      <div className=\"absolute inset-0 bg-cyber-dots opacity-15 pointer-events-none\" />\n      <div className=\"absolute top-1/4 -left-48 w-96 h-96 bg-blue-950/20 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute bottom-1/4 -right-48 w-96 h-96 bg-red-950/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-6xl mx-auto relative z-10\">\n        {/* Section Header */}\n        <div className=\"flex flex-col items-center text-center mb-20\">\n          <div className=\"flex items-center gap-2 px-3.5 py-1 bg-[#091120] border border-cyan-500/50 clip-chamfer mb-3\">\n            <Radio className=\"w-3.5 h-3.5 text-cyan-400 animate-pulse\" />\n            <span className=\"font-mono text-xs text-cyan-300 tracking-widest font-semibold uppercase\">\n              SECTION 03 // MISSION TIMELINE\n            </span>\n          </div>\n\n          <h2 className=\"font-orbitron font-black text-3xl sm:text-5xl tracking-wide text-slate-100 uppercase\">\n            OPERATIONAL <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-red-500\">ROADMAP</span>\n          </h2>\n          <p className=\"mt-3 max-w-xl text-slate-400 font-sans text-sm sm:text-base\">\n            Energon power conduit mapping critical deployment milestones from initiation to the Quantum Arena.\n          </p>\n        </div>\n\n        {/* TIMELINE CONTAINER */}\n        <div className=\"relative\">\n          {/* Central Glowing Energon Power Rail */}\n          <div className=\"hidden md:block absolute left-1/2 top-8 bottom-8 w-1 -translate-x-1/2 bg-gradient-to-b from-cyan-500 via-blue-500 to-red-600 shadow-[0_0_15px_rgba(0,240,255,0.8)]\" />\n\n          {/* Glowing Travelling Energy Pulse */}\n          <div className=\"hidden md:block absolute left-1/2 top-0 -translate-x-1/2 w-3 h-24 bg-gradient-to-b from-transparent via-white to-transparent rounded-full blur-[2px] animate-scanline\" />\n\n          {/* 6 MILESTONES */}\n          <div className=\"space-y-12 sm:space-y-16\">\n            {ROADMAP_MILESTONES.map((milestone, idx) => {\n              const isEven = idx % 2 === 0;\n              const isFinal = milestone.isFinal;\n\n              return (\n                <div\n                  key={milestone.phaseId}\n                  className={`relative flex flex-col md:flex-row items-center ${\n                    isEven ? \'md:flex-row-reverse\' : \'\'\n                  } gap-6 md:gap-12`}\n                >\n                  {/* CENTRAL MECHANICAL NODE DISK */}\n                  <div className=\"hidden md:flex absolute left-1/2 -translate-x-1/2 w-12 h-12 rounded-full bg-[#080f1d] border-2 border-cyan-400 items-center justify-center shadow-[0_0_20px_rgba(0,240,255,0.6)] z-20\">\n                    <div className=\"w-4 h-4 rounded-full bg-red-500 shadow-[0_0_10px_#ef4444] animate-pulse\" />\n                  </div>\n\n                  {/* CONTENT CARD (Left or Right) */}\n                  <div className=\"w-full md:w-1/2\">\n                    <motion.div\n                      initial={{ opacity: 0, x: isEven ? 50 : -50 }}\n                      whileInView={{ opacity: 1, x: 0 }}\n                      viewport={{ once: true }}\n                      transition={{ duration: 0.6 }}\n                      onMouseEnter={() => {\n                        playHover();\n                        playServo();\n                      }}\n                      className={`relative bg-gradient-to-b from-[#0a1324] via-[#070c17] to-[#04070e] border-2 ${\n                        isFinal\n                          ? \'border-red-500 shadow-[0_0_35px_rgba(239,68,68,0.5)] p-8\'\n                          : \'border-slate-700 hover:border-cyan-400 p-6\'\n                      } clip-chamfer transition-all duration-300 group`}\n                    >\n                      {/* Top Phase Header */}\n                      <div className=\"flex items-center justify-between pb-3 mb-4 border-b border-slate-800\">\n                        <div className=\"flex items-center gap-2\">\n                          <span\n                            className={`font-mono text-xs font-bold px-2.5 py-0.5 clip-banner ${\n                              isFinal\n                                ? \'bg-red-600 text-white shadow-[0_0_10px_#ef4444]\'\n                                : \'bg-cyan-950 text-cyan-300 border border-cyan-500/40\'\n                            }`}\n                          >\n                            {milestone.phaseCode}\n                          </span>\n                          {milestone.status && (\n                            <span className=\"font-mono text-[10px] text-amber-400 bg-amber-950/60 px-2 py-0.5 border border-amber-500/40 clip-chamfer\">\n                              [{milestone.status}]\n                            </span>\n                          )}\n                        </div>\n\n                        <span className=\"font-mono text-[10px] text-slate-500\">\n                          SEQ_0{idx + 1}\n                        </span>\n                      </div>\n\n                      {/* Milestone Title */}\n                      <h3\n                        className={`font-orbitron font-black tracking-wider text-slate-100 uppercase mb-2 ${\n                          isFinal ? \'text-2xl sm:text-3xl text-red-400\' : \'text-xl sm:text-2xl\'\n                        }`}\n                      >\n                        {milestone.title}\n                      </h3>\n\n                      {/* Description */}\n                      <p className=\"text-sm text-slate-300 font-sans leading-relaxed mb-5\">\n                        {milestone.description}\n                      </p>\n\n                      {/* Date & Time Badges */}\n                      <div className=\"flex flex-wrap items-center gap-3 pt-4 border-t border-slate-800/80 font-mono text-xs text-slate-300\">\n                        <div className=\"flex items-center gap-1.5 bg-black/60 px-3 py-1.5 rounded border border-slate-800\">\n                          <Calendar className=\"w-3.5 h-3.5 text-cyan-400\" />\n                          <span>{milestone.date}</span>\n                        </div>\n\n                        <div className=\"flex items-center gap-1.5 bg-black/60 px-3 py-1.5 rounded border border-slate-800\">\n                          <Clock className=\"w-3.5 h-3.5 text-amber-400\" />\n                          <span>{milestone.time}</span>\n                        </div>\n                      </div>\n\n                      {/* Special Indicator for Final Arena */}\n                      {isFinal && (\n                        <div className=\"mt-4 p-2.5 bg-red-950/50 border border-red-500/50 clip-chamfer font-mono text-xs text-red-200 flex items-center gap-2\">\n                          <Flame className=\"w-4 h-4 text-amber-400 animate-pulse\" />\n                          <span>GRAND FINALE: OFFLINE TACTICAL SHOWDOWN</span>\n                        </div>\n                      )}\n                    </motion.div>\n                  </div>\n\n                  {/* Empty Spacer on Opposite Side for Desktop balance */}\n                  <div className=\"hidden md:block w-1/2\" />\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
