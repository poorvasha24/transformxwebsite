  file_change {
    absolute_path_uri: "file:///src/components/ThemesSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport {\n  Bot,\n  Cpu,\n  ShieldCheck,\n  GraduationCap,\n  Car,\n  Zap,\n  Flame,\n  Layers,\n  Sparkles,\n  ArrowRight,\n  Maximize2\n} from \'lucide-react\';\nimport { SIHTheme } from \'../types\';\nimport { SIH_THEMES } from \'../data/eventData\';\nimport { ThemeDetailModal } from \'./ThemeDetailModal\';\nimport { playHover, playTransformation, playUiBeep } from \'../utils/audio\';\n\nexport const ThemesSection: React.FC = () => {\n  const [selectedThemeId, setSelectedThemeId] = useState<string | null>(null);\n\n  const selectedTheme = SIH_THEMES.find((t) => t.id === selectedThemeId) || null;\n\n  const handleOpenTheme = (themeId: string) => {\n    playTransformation();\n    setSelectedThemeId(themeId);\n  };\n\n  const getThemeIcon = (type: SIHTheme[\'iconType\']) => {\n    switch (type) {\n      case \'automation\':\n        return <Cpu className=\"w-6 h-6 text-cyan-400\" />;\n      case \'robotics\':\n        return <Bot className=\"w-6 h-6 text-red-400\" />;\n      case \'blockchain\':\n        return <ShieldCheck className=\"w-6 h-6 text-blue-400\" />;\n      case \'education\':\n        return <GraduationCap className=\"w-6 h-6 text-amber-400\" />;\n      case \'vehicles\':\n        return <Car className=\"w-6 h-6 text-red-500\" />;\n      case \'energy\':\n        return <Zap className=\"w-6 h-6 text-cyan-300\" />;\n      case \'disaster\':\n        return <Flame className=\"w-6 h-6 text-amber-500\" />;\n      default:\n        return <Layers className=\"w-6 h-6 text-cyan-400\" />;\n    }\n  };\n\n  return (\n    <section id=\"themes\" className=\"relative py-24 px-4 bg-[#060a14] overflow-hidden\">\n      {/* Background Cybernetic Ring Matrix */}\n      <div className=\"absolute inset-0 bg-cyber-grid opacity-20 pointer-events-none\" />\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full border border-cyan-500/10 pointer-events-none animate-spin [animation-duration:120s]\" />\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[950px] h-[950px] rounded-full border border-red-500/10 pointer-events-none animate-spin [animation-duration:160s] [animation-direction:reverse]\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        {/* Section Header */}\n        <div className=\"flex flex-col items-center text-center mb-16\">\n          <div className=\"flex items-center gap-2 px-3.5 py-1 bg-[#0a1426] border border-red-500/50 clip-chamfer mb-3\">\n            <span className=\"w-2 h-2 rounded-full bg-red-500 animate-pulse\" />\n            <span className=\"font-mono text-xs text-red-400 tracking-widest font-semibold uppercase\">\n              SECTION 02 // SEVEN NATIONAL DOMAINS\n            </span>\n          </div>\n\n          <h2 className=\"font-orbitron font-black text-3xl sm:text-5xl tracking-wide text-slate-100 uppercase\">\n            SIH <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-cyan-400\">INNOVATION MATRIX</span>\n          </h2>\n          <p className=\"mt-3 max-w-2xl text-slate-400 font-sans text-sm sm:text-base\">\n            Select an armored mission bay to unlock tactical blueprints, technical parameters, and impact vectors.\n          </p>\n        </div>\n\n        {/* 7 INTERACTIVE MECHANICAL MODULES IN DYNAMIC ASYMMETRICAL COMMAND BAY FORMATION */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {SIH_THEMES.map((theme, index) => {\n            // Give specific visual character to different slots\n            const isFeatured = index === 0; // Smart Automation gets extra command span\n            const isRedAccent = theme.accentColor === \'red\';\n            const isAmberAccent = theme.accentColor === \'amber\';\n\n            return (\n              <motion.div\n                key={theme.id}\n                initial={{ opacity: 0, y: 30 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: index * 0.08 }}\n                onClick={() => handleOpenTheme(theme.id)}\n                onMouseEnter={() => {\n                  playHover();\n                  playUiBeep(800 + index * 80);\n                }}\n                className={`group relative bg-gradient-to-b from-[#0c1629] via-[#080f1e] to-[#040812] border-2 ${\n                  isRedAccent\n                    ? \'border-slate-700 hover:border-red-500 hover:shadow-[0_0_30px_rgba(239,68,68,0.4)]\'\n                    : isAmberAccent\n                    ? \'border-slate-700 hover:border-amber-400 hover:shadow-[0_0_30px_rgba(245,158,11,0.4)]\'\n                    : \'border-slate-700 hover:border-cyan-400 hover:shadow-[0_0_30px_rgba(0,240,255,0.4)]\'\n                } p-6 clip-chamfer cursor-pointer transition-all duration-300 flex flex-col justify-between ${\n                  isFeatured ? \'md:col-span-2 lg:col-span-1\' : \'\'\n                }`}\n              >\n                {/* Mechanical Corner Bolts */}\n                <div className=\"absolute top-2 left-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n                <div className=\"absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n                <div className=\"absolute bottom-2 left-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n                <div className=\"absolute bottom-2 right-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n\n                {/* Top Module Header */}\n                <div>\n                  <div className=\"flex items-center justify-between pb-3 mb-4 border-b border-slate-800\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-mono text-xs font-black text-cyan-400 bg-black/60 px-2 py-0.5 border border-cyan-500/30 clip-banner\">\n                        DOM_{theme.number}\n                      </span>\n                      <span className=\"font-mono text-[10px] text-slate-400 tracking-wider\">\n                        {theme.armorCode}\n                      </span>\n                    </div>\n\n                    <div className=\"p-1 text-slate-500 group-hover:text-cyan-300 transition-colors\">\n                      <Maximize2 className=\"w-4 h-4\" />\n                    </div>\n                  </div>\n\n                  {/* Icon & Theme Title */}\n                  <div className=\"flex items-center gap-3.5 mb-3\">\n                    <div className=\"w-12 h-12 rounded-lg bg-black/70 border border-slate-700 flex items-center justify-center clip-chamfer group-hover:scale-105 transition-transform shadow-[inset_0_0_12px_rgba(0,0,0,0.8)]\">\n                      {getThemeIcon(theme.iconType)}\n                    </div>\n                    <div>\n                      <h3 className=\"font-orbitron font-black text-lg text-slate-100 group-hover:text-cyan-300 transition-colors tracking-wide\">\n                        {theme.title}\n                      </h3>\n                    </div>\n                  </div>\n\n                  {/* Short Description */}\n                  <p className=\"text-xs sm:text-sm text-slate-300 line-clamp-3 leading-relaxed font-sans mb-4\">\n                    {theme.shortDescription}\n                  </p>\n                </div>\n\n                {/* Bottom Action Footer */}\n                <div className=\"pt-4 border-t border-slate-800/80 flex items-center justify-between\">\n                  <span className=\"font-mono text-[10px] text-slate-400 uppercase tracking-widest\">\n                    {theme.tacticalSpecs.deploymentSector}\n                  </span>\n                  <div className=\"flex items-center gap-1 font-mono text-xs text-cyan-400 group-hover:translate-x-1 transition-transform font-bold\">\n                    