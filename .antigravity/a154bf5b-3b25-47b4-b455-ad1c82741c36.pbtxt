index) => {\n            // Give specific visual character to different slots\n            const isFeatured = index === 0; // Smart Automation gets extra command span\n            const isRedAccent = theme.accentColor === \'red\';\n            const isAmberAccent = theme.accentColor === \'amber\';\n\n            return (\n              <motion.div\n                key={theme.id}\n                initial={{ opacity: 0, y: 30 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: index * 0.08 }}\n                onClick={() => handleOpenTheme(theme.id)}\n                onMouseEnter={() => {\n                  playHover();\n                  playUiBeep(800 + index * 80);\n                }}\n                className={`group relative bg-gradient-to-b from-[#0c1629] via-[#080f1e] to-[#040812] border-2 ${\n                  isRedAccent\n                    ? \'border-slate-700 hover:border-red-500 hover:shadow-[0_0_30px_rgba(239,68,68,0.4)]\'\n                    : isAmberAccent\n                    ? \'border-slate-700 hover:border-amber-400 hover:shadow-[0_0_30px_rgba(245,158,11,0.4)]\'\n                    : \'border-slate-700 hover:border-cyan-400 hover:shadow-[0_0_30px_rgba(0,240,255,0.4)]\'\n                } p-6 clip-chamfer cursor-pointer transition-all duration-300 flex flex-col justify-between ${\n                  isFeatured ? \'md:col-span-2 lg:col-span-1\' : \'\'\n                }`}\n              >\n                {/* Mechanical Corner Bolts */}\n                <div className=\"absolute top-2 left-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n                <div className=\"absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n                <div className=\"absolute bottom-2 left-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n                <div className=\"absolute bottom-2 right-2 w-1.5 h-1.5 rounded-full bg-slate-600\" />\n\n               