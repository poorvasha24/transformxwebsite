    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Calendar, Clock, Coffee, Shield, Zap, Sparkles, AlertCircle, Compass, Radio } from \'lucide-react\';\nimport { playHover, playServo, playUiBeep } from \'../utils/audio\';\n\nexport const EventDetails: React.FC = () => {\n  return (\n    <section id=\"event\" className=\"relative py-24 px-4 bg-[#050811]/90 border-t border-b border-slate-800/80 overflow-hidden\">\n      {/* Background Cyber Ambient */}\n      <div className=\"absolute inset-0 bg-cyber-dots opacity-15 pointer-events-none\" />\n      <div className=\"absolute -top-32 right-1/4 w-96 h-96 bg-cyan-950/20 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute -bottom-32 left-1/4 w-96 h-96 bg-red-950/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto\">\n        {/* Section Header */}\n        <div className=\"flex flex-col items-center text-center mb-16\">\n          <div className=\"flex items-center gap-2 px-3.5 py-1 bg-[#091122] border border-cyan-500/50 clip-chamfer mb-3\">\n            <Radio className=\"w-3.5 h-3.5 text-cyan-400 animate-pulse\" />\n            <span className=\"font-mono text-xs text-cyan-300 tracking-widest font-semibold uppercase\">\n              SECTION 01 // MISSION PARAMETERS\n            </span>\n          </div>\n\n          <h2 className=\"font-orbitron font-black text-3xl sm:text-5xl tracking-wide text-slate-100 uppercase\">\n            EVENT <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500\">SPECIFICATIONS</span>\n          </h2>\n          <p className=\"mt-3 max-w-xl text-slate-400 font-sans text-sm sm:text-base\">\n            Tactical parameters and logistical provisions engineered for peak builder performance.\n          </p>\n        </div>\n\n        {/* 3 DISTINCT MECHANICAL MODULES */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n          {/* MODULE 1: EVENT DATE (Inspired by Chest Armor Module) */}\n          <motion.div\n            initial={{ opacity: 0, y: 30 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.6 }}\n            onMouseEnter={() => {\n              playHover();\n              playServo();\n            }}\n            className=\"group relative bg-gradient-to-b from-[#0b1424] via-[#080d19] to-[#04060d] border-2 border-slate-700 hover:border-red-500 p-6 sm:p-8 clip-chamfer transition-all duration-300 shadow-[0_0_30px_rgba(0,0,0,0.8)] flex flex-col justify-between\"\n          >\n            {/* Top Mechanical Plate Ridge */}\n            <div className=\"flex items-center justify-between pb-4 mb-4 border-b border-slate-800\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-mono text-[10px] text-red-400 font-bold tracking-widest bg-red-950/60 px-2 py-0.5 border border-red-500/40 clip-banner\">\n                  SYS_PARAM_01\n                </span>\n                <span className=\"font-mono text-[11px] text-slate-400\">CHEST_ARMOR_CORE</span>\n              </div>\n              <div className=\"flex gap-1\">\n                <div className=\"w-2 h-2 rounded-full bg-red-500 shadow-[0_0_6px_#ef4444]\" />\n                <div className=\"w-2 h-2 rounded-full bg-slate-700\" />\n              </div>\n            </div>\n\n            {/* Visual Centerpiece: Optimus Chest Armor Emblem & Date */}\n            <div className=\"my-4\">\n              <div className=\"w-14 h-14 rounded-lg bg-red-950/80 border-2 border-red-500 flex items-center justify-center mb-6 clip-chamfer group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(239,68,68,0.5)]\">\n                <Calendar className=\"w-7 h-7 text-red-300\" />\n              </div>\n\n              <div className=\"font-mono text-xs text-red-400 tracking-widest font-semibold uppercase mb-1\">\n                LAUNCH DATE\n              </div>\n              <div className=\"font-orbitron font-black text-2xl sm:text-3xl text-slate-100 tracking-wider\">\n                25 SEPTEMBER 2026\n              </div>\n\n              <div className=\"mt-4 p-3 bg-black/50 border border-slate-800 rounded font-mono text-xs text-slate-300 space-y-1\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">DEPLOYMENT:</span>\n                  <span className=\"text-cyan-400\">NATIONAL PHASE</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">SYNC INTERVAL:</span>\n                  <span className=\"text-emerald-400\">T-08:00 HRS IST</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Mechanical Rivets */}\n            <div className=\"mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between font-mono text-[10px] text-slate-500\">\n              <span>[ARMOR_SEAL: LOCKED]</span>\n              <span className=\"text-red-400\">[PRIORITY_OMEGA]</span>\n            </div>\n          </motion.div>\n\n          {/* MODULE 2: DURATION (Inspired by Energy Core & Vehicle Dashboard) */}\n          <motion.div\n            initial={{ opacity: 0, y: 30 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.6, delay: 0.15 }}\n            onMouseEnter={() => {\n              playHover();\n              playUiBeep(1100);\n            }}\n            className=\"group relative bg-gradient-to-b from-[#0b182d] via-[#081021] to-[#040813] border-2 border-slate-700 hover:border-cyan-400 p-6 sm:p-8 clip-chamfer transition-all duration-300 shadow-[0_0_30px_rgba(0,0,0,0.8)] flex flex-col justify-between\"\n          >\n            {/* Top Plate */}\n            <div className=\"flex items-center justify-between pb-4 mb-4 border-b border-slate-800\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-mono text-[10px] text-cyan-400 font-bold tracking-widest bg-cyan-950/60 px-2 py-0.5 border border-cyan-500/40 clip-banner\">\n                  SYS_PARAM_02\n                </span>\n                <span className=\"font-mono text-[11px] text-slate-400\">OVERCLOCK_PLASMA</span>\n              </div>\n              <div className=\"flex gap-1\">\n                <div className=\"w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_6px_#00f0ff] animate-pulse\" />\n                <div className=\"w-2 h-2 rounded-full bg-cyan-400\" />\n              </div>\n            </div>\n\n            {/* Visual Centerpiece: Rotating Tachometer Plasma Core & 8 Hours */}\n            <div className=\"my-4\">\n              <div className=\"w-14 h-14 rounded-lg bg-cyan-950/80 border-2 border-cyan-400 flex items-center justify-center mb-6 clip-chamfer group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(0,240,255,0.5)]\">\n                <Clock className=\"w-7 h-7 text-cyan-300 animate-spin [animation-duration:12s]\" />\n              </div>\n\n              <div className=\"font-mono text-xs text-cyan-400 tracking-widest font-semibold uppercase mb-1\">\n                MISSION DURATION\n              </div>\n              <div className=\"font-orbitron font-black text-3xl sm:text-4xl text-slate-100 tracking-wider flex items-baseline gap-2\">\n                <span>8 HOURS</span>\n                <span className=\"text-sm font-mono text-cyan-400 font-semibold\">[NON-STOP]</span>\n              </div>\n\n              <div className=\"mt-4 p-3 bg-black/50 border border-slate-800 rounded font-mono text-xs text-slate-300 space-y-1\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">OPERATING MODE:</span>\n                  <span className=\"text-amber-400\">RAPID BUILD SPRINT</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">OUTPUT GAIN:</span>\n                  <span className=\"text-cyan-400\">100% MAXIMUM DRIVE</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Status */}\n            <div className=\"mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between font-mono text-[10px] text-slate-500\">\n              <span>[CORE_RPM: 9800]</span>\n              <span className=\"text-cyan-400\">[OVERCLOCK_READY]</span>\n            </div>\n          </motion.div>\n\n          {/* MODULE 3: FUEL PROVISION (Inspired by Energon Logistics Supply Module) */}\n          <motion.div\n            initial={{ opacity: 0, y: 30 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.6, delay: 0.3 }}\n            onMouseEnter={() => {\n              playHover();\n              playServo();\n            }}\n            className=\"group relative bg-gradient-to-b from-[#141209] via-[#0d0d08] to-[#060604] border-2 border-slate-700 hover:border-amber-400 p-6 sm:p-8 clip-chamfer transition-all duration-300 shadow-[0_0_30px_rgba(0,0,0,0.8)] flex flex-col justify-between\"\n          >\n            {/* Top Plate */}\n            <div className=\"flex items-center justify-between pb-4 mb-4 border-b border-slate-800\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-mono text-[10px] text-amber-400 font-bold tracking-widest bg-amber-950/60 px-2 py-0.5 border border-amber-500/40 clip-banner\">\n                  SYS_PARAM_03\n                </span>\n                <span className=\"font-mono text-[11px] text-slate-400\">ENERGON_CARGO</span>\n              </div>\n              <div className=\"flex gap-1\">\n                <div className=\"w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_6px_#f59e0b]\" />\n                <div className=\"w-2 h-2 rounded-full bg-slate-700\" />\n              </div>\n            </div>\n\n            {/* Visual Centerpiece: Supply Crate & Snacks Provided */}\n            <div className=\"my-4\">\n              <div className=\"w-14 h-14 rounded-lg bg-amber-950/80 border-2 border-amber-400 flex items-center justify-center mb-6 clip-chamfer group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.5)]\">\n                <Coffee className=\"w-7 h-7 text-amber-300\" />\n              </div>\n\n              <div className=\"font-mono text-xs text-amber-400 tracking-widest font-semibold uppercase mb-1\">\n                FUEL PROVISION\n              </div>\n              <div className=\"font-orbitron font-black text-2xl sm:text-3xl text-slate-100 tracking-wider\">\n                SNACKS PROVIDED\n              </div>\n\n              <div className=\"mt-4 p-3 bg-black/50 border border-slate-800 rounded font-mono text-xs text-slate-300 space-y-1\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">RATION STATUS:</span>\n                  <span className=\"text-emerald-400\">FULLY STOCKED</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">BEVERAGES & FUEL:</span>\n                  <span className=\"text-amber-300\">CONTINUOUS PROVISION</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Status */}\n            <div className=\"mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between font-mono text-[10px] text-slate-500\">\n              <span>[PAYLOAD_BAY: ACTIVE]</span>\n              <span className=\"text-amber-400\">[HYDRATION_100%]</span>\n            </div>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
