 clip-path: polygon(0 0, 100% 0, 100% 3px, 3px 3px, 3px calc(100% - 3px), 100% calc(100% - 3px), 100% 100%, 0 100%);\n}\n\n.clip-bracket-r {\n  clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 calc(100% - 3px), calc(100% - 3px) calc(100% - 3px), calc(100% - 3px) 3px, 0 3px);\n}\n\n/* Sophisticated Dark Cybernetic Grids & Radial Dots */\n.bg-sophisticated-radial {\n  background-image: radial-gradient(#1e3a8a 1px, transparent 1px);\n  background-size: 32px 32px;\n}\n\n.bg-cyber-grid {\n  background-size: 32px 32px;\n  background-image: \n    linear-gradient(to right, rgba(0, 163, 255, 0.05) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(0, 163, 255, 0.05) 1px, transparent 1px);\n}\n\n.bg-cyber-dots {\n  background-size: 28px 28px;\n  background-image: radial-gradient(rgba(0, 163, 255, 0.18) 1px, transparent 1px);\n}\n\n.bg-hazard-stripes {\n  background: repeating-linear-gradient(\n    -45deg,\n    rgba(204, 0, 0, 0.18),\n    rgba(204, 0, 0, 0.18) 10px,\n    rgba(10, 15, 29, 0.6) 10px,\n    rgba(10, 15, 29, 0.6) 20px\n  );\n}\n\n.bg-hazard-stripes-cyan {\n  background: repeating-linear-gradient(\n    -45deg,\n    rgba(0, 163, 255, 0.15),\n    rgba(0, 163, 255, 0.15) 8px,\n    rgba(10, 15, 29, 0.6) 8px,\n    rgba(10, 15, 29, 0.6) 16px\n  );\n}\n\n/* Sophisticated Dark Glow Utilities */\n.glow-cyan {\n  filter: drop-shadow(0 0 8px rgba(0, 163, 255, 0.6)) drop-shadow(0 0 16px rgba(0, 163, 255, 0.3));\n}\n\n.glow-red {\n  filter: drop-shadow(0 0 8px rgba(204, 0, 0, 0.7)) drop-shadow(0 0 16px rgba(204, 0, 0, 0.35));\n}\n\n.glow-blue {\n  filter: drop-shadow(0 0 8px rgba(0, 163, 255, 0.7)) drop-shadow(0 0 16px rgba(0, 163, 255, 0.35));\n}\n\n.text-glow-cyan {\n  text-shadow: 0 0 8px rgba(0, 163, 255, 0.8), 0 0 16px rgba(0, 163, 255, 0.4);\n}\n\n.text-glow-red {\n  text-shadow: 0 0 8px rgba(204, 0, 0, 0.8), 0 0 16px rgba(204, 0, 0, 0.4);\n}\n\n.text-glow-white {\n  text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 0 20px rgba(0, 163, 255, 0.4);\n}\n\n/* Scanline Animation */\n@keyframes scanline {\n  0% {\n    transform: translateY(-100%);\n  }\n  100% {\n    transform: translateY(1000%);\n  }\n}\n\n.animate-scanline {\n  animation: scanline 8s linear infinite;\n}\n\n/* Mechanical Pulse */\n@keyframes mech-pulse {\n  0%, 100% {\n    opacity: 0.3;\n    transform: scale(0.98);\n  }\n  50% {\n    opacity: 0.9;\n    transform: scale(1.02);\n  }\n}\n\n.animate-mech-pulse {\n  animation: mech-pulse 3s ease-in-out infinite;\n}\n\n/* Custom Scrollbar for Sophisticated Dark Theme */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #05070a;\n  border-left: 1px solid #1e293b;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #1e293b;\n  border: 1px solid #00A3FF;\n  border-radius: 2px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #cc0000;\n  border-color: #ff3333;\n}"
