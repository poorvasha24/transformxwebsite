    replacement_infos {
      original_chunk {
        target_content: "export const Footer: React.FC<FooterProps> = ({ onNavigate, onReplayIntro }) => {\n  return (\n    <footer className=\"relative bg-[#03050a] border-t-2 border-slate-800 pt-16 pb-12 px-4 select-none font-orbitron overflow-hidden\">\n      {/* Background Grid */}\n      <div className=\"absolute inset-0 bg-cyber-grid opacity-10 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-slate-800\">\n          {/* Col 1: Brand & Matrix Core */}\n          <div className=\"md:col-span-2 space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-8 h-8 rounded bg-red-600 border border-red-400 flex items-center justify-center clip-chamfer shadow-[0_0_15px_rgba(239,68,68,0.7)]\">\n                <Cpu className=\"w-5 h-5 text-white\" />\n              </div>\n              <span className=\"font-orbitron font-black text-2xl tracking-widest text-slate-100\">\n                TRANSFORM<span className=\"text-red-500\">X</span>\n              </span>\n            </div>\n\n            <p className=\"max-w-md text-sm text-slate-400 font-sans leading-relaxed\">\n              A high-impact national hackathon platform engineered for visionaries, builders, and robotics innovators. Powered by mechanical transformation design principles.\n            </p>\n\n            <div className=\"flex items-center gap-3 font-mono text-xs text-cyan-400 pt-2\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]\" />\n              <span>CORE SYSTEM STATUS: ALL CHANNELS NOMINAL</span>\n            </div>\n          </div>\n\n          {/* Col 2: Navigation Links */}\n          <div>\n            <h4 className=\"font-mono text-xs text-red-400 font-bold tracking-widest uppercase mb-4\">\n              [COMMAND CHANNELS]\n            </h4>\n            <ul className=\"space-y-2 text-sm font-sans text-slate-300\">\n              <li>\n                <button\n                  onClick={() => onNavigate(\'hero\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-cyan-400 transition-colors cursor-pointer\"\n                >\n                  &gt; Portal Home\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'event\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-cyan-400 transition-colors cursor-pointer\"\n                >\n                  &gt; Event Specifications\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'themes\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-cyan-400 transition-colors cursor-pointer\"\n                >\n                  &gt; Seven SIH Domains\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'roadmap\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-cyan-400 transition-colors cursor-pointer\"\n                >\n                  &gt; Operational Roadmap\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'register\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-cyan-400 transition-colors cursor-pointer\"\n                >\n                  &gt; Initiate Registration\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Tactical Telemetry & Replay Intro */}\n          <div>\n            <h4 className=\"font-mono text-xs text-cyan-400 font-bold tracking-widest uppercase mb-4\">\n              [TACTICAL INTEL]\n            </h4>\n            <div className=\"space-y-3 font-mono text-xs text-slate-400\">\n              <p>MISSION DATE: 25 SEP 2026</p>\n              <p>DURATION: 8 HOURS ACTIVE SPRINT</p>\n              <p>SECTORS: 07 INNOVATION DOMAINS</p>\n              <button\n                onClick={() => {\n                  playClick();\n                  onReplayIntro();\n                }}\n                onMouseEnter={playHover}\n                className=\"mt-2 inline-flex items-center gap-2 px-3 py-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-cyan-400 text-cyan-300 clip-chamfer transition-colors cursor-pointer\"\n              >\n                <Radio className=\"w-3.5 h-3.5 text-red-400\" />\n                <span>REPLAY INTRO CINEMATIC</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Bar */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-slate-500\">\n          <div>\n            &copy; 2026 TRANSFORMX HACKATHON. ALL TACTICAL RIGHTS RESERVED.\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span>TRANSFORM. BUILD. DEPLOY THE FUTURE.</span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};"
        replacement_content: "export const Footer: React.FC<FooterProps> = ({ onNavigate, onReplayIntro }) => {\n  return (\n    <footer className=\"relative bg-[#020408] border-t border-[#1e293b] select-none font-sans overflow-hidden\">\n      {/* Upper Content Section */}\n      <div className=\"max-w-7xl mx-auto px-6 py-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-[#1e293b]\">\n          {/* Col 1: Brand & Description */}\n          <div className=\"md:col-span-2 space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-7 h-7 bg-[#cc0000] rotate-45 flex items-center justify-center border border-white/20 shadow-[0_0_12px_rgba(204,0,0,0.6)]\">\n                <div className=\"w-3.5 h-3.5 bg-white/10\" />\n              </div>\n              <span className=\"font-orbitron font-black text-xl tracking-[0.2em] text-white\">\n                TRANSFORM<span className=\"text-[#cc0000]\">X</span>\n              </span>\n            </div>\n\n            <p className=\"max-w-md text-xs text-gray-400 font-sans leading-relaxed\">\n              A premier national hackathon platform engineered for visionaries, builders, and robotics innovators. Powered by mechanical transformation design principles.\n            </p>\n\n            <div className=\"flex items-center gap-2 font-mono text-[10px] text-[#00A3FF] pt-1\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]\" />\n              <span>CORE SYSTEM STATUS: ALL CHANNELS NOMINAL</span>\n            </div>\n          </div>\n\n          {/* Col 2: Navigation Links */}\n          <div>\n            <h4 className=\"font-mono text-[10px] text-[#cc0000] font-bold tracking-[0.3em] uppercase mb-3\">\n              // COMMAND CHANNELS\n            </h4>\n            <ul className=\"space-y-2 text-xs font-mono text-gray-400\">\n              <li>\n                <button\n                  onClick={() => onNavigate(\'hero\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-[#00A3FF] transition-colors cursor-pointer\"\n                >\n                  &gt; PORTAL_HOME\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'event\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-[#00A3FF] transition-colors cursor-pointer\"\n                >\n                  &gt; EVENT_SPECS\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'themes\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-[#00A3FF] transition-colors cursor-pointer\"\n                >\n                  &gt; SEVEN_DOMAINS\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'roadmap\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-[#00A3FF] transition-colors cursor-pointer\"\n                >\n                  &gt; MISSION_ROADMAP\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => onNavigate(\'register\')}\n                  onMouseEnter={playHover}\n                  className=\"hover:text-[#00A3FF] transition-colors cursor-pointer\"\n                >\n                  &gt; INITIATE_REGISTRATION\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Tactical Telemetry & Replay Intro */}\n          <div>\n            <h4 className=\"font-mono text-[10px] text-[#00A3FF] font-bold tracking-[0.3em] uppercase mb-3\">\n              // TACTICAL INTEL\n            </h4>\n            <div className=\"space-y-2 font-mono text-xs text-gray-400\">\n              <p>MISSION DATE: 25 SEP 2026</p>\n              <p>DURATION: 8 HOURS ACTIVE SPRINT</p>\n              <p>SECTORS: 07 INNOVATION DOMAINS</p>\n              <button\n                onClick={() => {\n                  playClick();\n                  onReplayIntro();\n                }}\n                onMouseEnter={playHover}\n                className=\"mt-2 inline-flex items-center gap-2 px-3 py-1.5 bg-black/40 hover:bg-[#0a0f1d] border border-[#1e293b] hover:border-[#00A3FF]/60 text-gray-300 hover:text-white text-[10px] font-mono tracking-wider transition-colors cursor-pointer\"\n              >\n                <Radio className=\"w-3 h-3 text-[#cc0000]\" />\n                <span>REPLAY INTRO CINEMATIC</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[10px] text-gray-500\">\n          <div>\n            &copy; 2026 TRANSFORMX HACKATHON. ALL TACTICAL RIGHTS RESERVED.\n          </div>\n          <div className=\"text-gray-400\">\n            TRANSFORM. BUILD. DEPLOY THE FUTURE.\n          </div>\n        </div>\n      </div>\n\n      {/* Sophisticated Dark Bottom Telemetry Bar */}\n      <div className=\"bg-black border-t border-[#1e293b] py-3 px-6 sm:px-12 text-[9px] font-mono text-gray-600 flex flex-wrap justify-between items-center uppercase tracking-[0.2em] gap-2\">\n        <span>SYSTEM STATUS: NOMINAL | GRID_COORD: 45.32.90 | LATENCY: 12MS</span>\n        <span className=\"text-[#00A3FF]/60\">v4.0.2_TRANSFORM</span>\n      </div>\n    </footer>\n  );\n};"
