  file_change {
    absolute_path_uri: "file:///src/components/CustomCursor.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState, useRef } from \'react\';\nimport { playClick } from \'../utils/audio\';\n\nexport const CustomCursor: React.FC = () => {\n  const [pos, setPos] = useState({ x: -100, y: -100 });\n  const [targetPos, setTargetPos] = useState({ x: -100, y: -100 });\n  const [isHovered, setIsHovered] = useState(false);\n  const [isClicked, setIsClicked] = useState(false);\n  const [isTouch, setIsTouch] = useState(false);\n  const trailRef = useRef<{ x: number; y: number }[]>([]);\n\n  useEffect(() => {\n    if (typeof window === \'undefined\') return;\n\n    // Check for touch device\n    if (\'ontouchstart\' in window || navigator.maxTouchPoints > 0) {\n      setIsTouch(true);\n      return;\n    }\n\n    const handleMouseMove = (e: MouseEvent) => {\n      setTargetPos({ x: e.clientX, y: e.clientY });\n\n      // Check if hovering over clickable element\n      const target = e.target as HTMLElement | null;\n      if (target) {\n        const isClickable = !!target.closest(\'button, a, input, [role=\"button\"], .clickable, .interactive-mech\');\n        setIsHovered(isClickable);\n      }\n    };\n\n    const handleMouseDown = () => {\n      setIsClicked(true);\n      playClick();\n    };\n\n    const handleMouseUp = () => {\n      setIsClicked(false);\n    };\n\n    window.addEventListener(\'mousemove\', handleMouseMove);\n    window.addEventListener(\'mousedown\', handleMouseDown);\n    window.addEventListener(\'mouseup\', handleMouseUp);\n\n    let animId: number;\n    const updateCursor = () => {\n      setPos((prev) => {\n        const dx = targetPos.x - prev.x;\n        const dy = targetPos.y - prev.y;\n        const newX = prev.x + dx * 0.35;\n        const newY = prev.y + dy * 0.35;\n\n        // Update trail\n        trailRef.current = [\n          { x: newX, y: newY },\n          ...(trailRef.current.slice(0, 5))\n        ];\n\n        return { x: newX, y: newY };\n      });\n      animId = requestAnimationFrame(updateCursor);\n    };\n\n    animId = requestAnimationFrame(updateCursor);\n\n    return () => {\n      window.removeEventListener(\'mousemove\', handleMouseMove);\n      window.removeEventListener(\'mousedown\', handleMouseDown);\n      window.removeEventListener(\'mouseup\', handleMouseUp);\n      cancelAnimationFrame(animId);\n    };\n  }, [targetPos]);\n\n  if (isTouch) return null;\n\n  return (\n    <div className=\"pointer-events-none fixed inset-0 z-[9999] overflow-hidden\">\n      {/* Energy trail dots */}\n      {trailRef.current.map((point, idx) => (\n        <div\n          key={idx}\n          className=\"absolute rounded-full pointer-events-none transition-opacity duration-150\"\n          style={{\n            left: `${point.x}px`,\n            top: `${point.y}px`,\n            width: `${Math.max(2, 6 - idx)}px`,\n            height: `${Math.max(2, 6 - idx)}px`,\n            transform: \'translate(-50%, -50%)\',\n            backgroundColor: isHovered ? \'#ef4444\' : \'#00f0ff\',\n            opacity: ((5 - idx) / 5) * 0.4,\n            boxShadow: isHovered\n              ? \'0 0 8px rgba(239, 68, 68, 0.8)\'\n              : \'0 0 8px rgba(0, 240, 255, 0.8)\',\n          }}\n        />\n      ))}\n\n      {/* Main Targeting Reticle Container */}\n      <div\n        className=\"absolute pointer-events-none -translate-x-1/2 -translate-y-1/2 transition-transform duration-100 ease-out\"\n        style={{\n          left: `${pos.x}px`,\n          top: `${pos.y}px`,\n          transform: `translate(-50%, -50%) scale(${isClicked ? 0.85 : isHovered ? 1.3 : 1})`,\n        }}\n      >\n        {/* Center glowing precision dot */}\n        <div\n          className={`absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full transition-colors duration-200 ${\n            isHovered ? \'w-2 h-2 bg-red-500 shadow-[0_0_12px_#ef4444]\' : \'w-1.5 h-1.5 bg-cyan-400 shadow-[0_0_10px_#00f0ff]\'\n          }`}\n        />\n\n        {/* Rotating Outer Reticle Rings */}\n        <div\n          className={`w-10 h-10 rounded-full border border-dashed transition-all duration-300 animate-spin ${\n            isHovered\n              ? \'border-red-500 scale-125 opacity-90 [animation-duration:3s]\'\n              : \'border-cyan-500/50 opacity-60 [animation-duration:8s]\'\n          }`}\n        />\n\n        {/* Crosshair Brackets: Top-Left */}\n        <div\n          className={`absolute -top-1 -left-1 w-2.5 h-2.5 border-t-2 border-l-2 transition-all duration-200 ${\n            isHovered ? \'border-red-400 translate-x-[-4px] translate-y-[-4px]\' : \'border-cyan-400\'\n          }`}\n        />\n        {/* Top-Right */}\n        <div\n          className={`absolute -top-1 -right-1 w-2.5 h-2.5 border-t-2 border-r-2 transition-all duration-200 ${\n            isHovered ? \'border-red-400 translate-x-[4px] translate-y-[-4px]\' : \'border-cyan-400\'\n          }`}\n        />\n        {/* Bottom-Left */}\n        <div\n          className={`absolute -bottom-1 -left-1 w-2.5 h-2.5 border-b-2 border-l-2 transition-all duration-200 ${\n            isHovered ? \'border-red-400 translate-x-[-4px] translate-y-[4px]\' : \'border-cyan-400\'\n          }`}\n        />\n        {/* Bottom-Right */}\n        <div\n          className={`absolute -bottom-1 -right-1 w-2.5 h-2.5 border-b-2 border-r-2 transition-all duration-200 ${\n            isHovered ? \'border-red-400 translate-x-[4px] translate-y-[4px]\' : \'border-cyan-400\'\n          }`}\n        />\n\n        {/* Tactical HUD Coordinates Readout */}\n        {isHovered && (\n          <div className=\"absolute top-5 left-5 font-mono text-[9px] tracking-widest text-red-400 whitespace-nowrap bg-black/80 px-1.5 py-0.5 border border-red-500/40 clip-chamfer\">\n            TARGET_LOCKED [X:{Math.round(pos.x)} Y:{Math.round(pos.y)}]\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
